{
  "manifest_version": 3,
  "name": "MapCzar",
  "version": "1.0.0",
  "description": "A Chrome extension that displays an interactive map overlay with Leaflet",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Open MapCzar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
